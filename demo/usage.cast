[0.000, "o", "  bright-sdk-download — CLI Demo\r\n"]
[0.000, "o", "\r\n"]
[1.008, "o", "\r\n\u001b[1;36m--- Show available commands ---\u001b[0m\r\n\r\n"]
[0.409, "o", "\u001b[1;32m❯\u001b[0m "]
