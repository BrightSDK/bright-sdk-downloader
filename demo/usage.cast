[0.051, "o", "\r\n"]
[0.511, "o", "bright-sdk — BrightSDK download CLI\r\n"]
[0.088, "o", "\r\n"]
[0.091, "o", "Commands:\r\n"]
[0.091, "o", "  resolve    Resolve version + download URL (JSON)\r\n"]
[0.091, "o", "  fetch      Download and extract SDK archive\r\n"]
[0.086, "o", "  platforms  List available platform keys\r\n"]
[0.091, "o", "\r\n"]
[0.091, "o", "Options:\r\n"]
[0.088, "o", "  -p, --platform   Platform key (android, ios, tizen...)\r\n"]
[0.089, "o", "  -v, --version    Version or \"latest\" (default: latest)\r\n"]
[0.091, "o", "  -o, --output     Output directory (default: .)\r\n"]
[0.094, "o", "\r\n"]
[0.093, "o", "Environment:\r\n"]
[0.094, "o", "  SDK_API_KEY      Required. BrightSDK API key.\r\n"]
[0.089, "o", "\r\n"]
[0.094, "o", "Examples:\r\n"]
[0.093, "o", "  bright-sdk resolve -p android\r\n"]
[0.088, "o", "  bright-sdk fetch -p ios -o ./libs\r\n"]
[0.091, "o", "  bright-sdk platforms\r\n"]
[1.414, "o", "\r\n\u001b[1;36m--- List available platforms ---\u001b[0m\r\n\r\n"]
